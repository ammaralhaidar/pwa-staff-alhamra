# Copy this file to .env for local development.
# Fill ODOO_PROXY_TARGET and VITE_ODOO_DATABASE from the backend environment you want to use.

# Local dev and Vercel should keep this empty so the app calls relative /api/*.
VITE_ODOO_BASE_URL=

# Example values:
# - local/dev: your_odoo_dev_database
# - preview/staging: your_odoo_staging_database
# - production: your_odoo_production_database
VITE_ODOO_DATABASE=

# Example values:
# - local/dev: https://your-odoo-dev-host
# - preview/staging: https://your-odoo-staging-host
# - production: https://your-odoo-production-host
ODOO_PROXY_TARGET=

VITE_AUTH_BYPASS=false
VITE_ENABLE_FALLBACK_DATA=false
VITE_API_DEBUG=false
VITE_PWA_DEV=false
